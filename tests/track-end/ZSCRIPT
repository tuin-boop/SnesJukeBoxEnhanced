version "4.14"
class SJTrackEndTest : StaticEventHandler
{
 ui int ticks, endedAt;
 ui bool finished;
 ui void Check(bool ok,String label){Console.Printf("SJ TEST %s: %s",ok?"PASS":"FAIL",label);}
 override void UiTick()
 {
  if(gamestate!=GS_LEVEL || finished)return;
  ticks++;let p=SJPlayer.Get();
  if(ticks==3)
  {
   SJPlayer.Set("sj_mode",0);SJPlayer.Set("sj_trackend",1);SJPlayer.Set("sj_interval",1);SJPlayer.Set("sj_sfx",0);
   SJPlayer.Set("sj_scope",1);SJPlayer.Set("sj_album",SJCatalog.AlbumID(377));
   p.PlayTrack(377,false);
   Check(!musplaying.loop && !p.trackLoops,"SPC playback is non-looping in song-end mode");
   Check(SJPlayer.AdvanceSeconds()==0,"fixed timer is disabled even with old interval saved");
   // Deliberately exceed every timer: completion must still come from audio.
   p.elapsed=999999;
  }
  if(ticks==73)Check(p.current==377 && p.active,"no early cut even when elapsed counter exceeds old timers");
  if(ticks>73 && endedAt==0 && p.current!=377)
  {
   endedAt=ticks;
   Check(ticks>350 && ticks<1400,"real original SPC reaches end before automatic shuffle");
   Check(level.MapName~=="MAP01" && SJCatalog.AlbumID(p.current)==SJCatalog.AlbumID(377),"end-of-song shuffle stays in album on the same map");
   Console.Printf("SJ end observed after %.2f seconds",(ticks-3)/35.0);
   SJPlayer.Set("sj_mode",2);
  }
  if(endedAt>0 && ticks==endedAt+3)
  {
   Check(musplaying.loop && p.trackLoops,"repeat track restores looping playback");
   p.StopPlayback();SJPlayer.Set("sj_mode",0);
  }
  if(endedAt>0 && ticks==endedAt+6)
  {
   Check(!p.active && musplaying.name~=="SILENCE","stop does not trigger end-of-track shuffle");
   p.RestoreMapMusic();
  }
  if(endedAt>0 && ticks==endedAt+9)
  {
   Check(!p.active && musplaying.name~=="D_RUNNIN","restored map music is not advanced by jukebox");
   Console.Printf("SJ TEST COMPLETE");finished=true;
  }
 }
}
